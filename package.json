{
  "name": "borrowed-sky",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A zero-install, browser-based AI sky companion that tells anyone, anywhere, what is overhead right now.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "catalog": "node scripts/build-catalog.mjs",
    "verify": "npm run typecheck && npm run verify:astro",
    "verify:astro": "tsx scripts/verify/frames.check.ts && tsx scripts/verify/satellites.check.ts && tsx scripts/verify/events.check.ts",
    "verify:ui": "node scripts/verify/screenshot.mjs && node scripts/verify/interact.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satellite.js": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
