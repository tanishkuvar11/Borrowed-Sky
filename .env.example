# IBM watsonx.ai credentials for the Granite narration layer.
#
# These are OPTIONAL. Without them the app runs exactly the same, computes
# exactly the same sky, and narrates it with the built-in deterministic
# narrator instead; the interface says which one is speaking.
#
# Copy to `.env` for local development, or set them as environment variables
# on your host. They are read server-side only and never reach the browser.

# Required to enable Granite. From IBM Cloud > Manage > Access (IAM) > API keys.
WATSONX_API_KEY=

# Required to enable Granite. From your watsonx.ai project's Manage tab.
WATSONX_PROJECT_ID=

# Optional. Regional endpoint for your watsonx instance.
# Defaults to https://us-south.ml.cloud.ibm.com
WATSONX_URL=

# Optional. Defaults to ibm/granite-3-3-8b-instruct
WATSONX_MODEL_ID=
